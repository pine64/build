[Unit]
Description=Avaota A1 First Boot Setup (Home Assistant + Assistant Stack)
After=docker.service
Wants=docker.service
ConditionPathExists=!/var/lib/avaota-first-setup-done

[Service]
Type=oneshot
ExecStart=/usr/local/bin/avaota-first-setup.sh
TimeoutStartSec=1h
StandardOutput=journal
StandardError=journal
