[Unit]
Description=Avaota A1 small LCD: VT2 console and status page
# No ordering against the display manager: VT switches wait until the boot has finished (see the script).
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/avaota-small-screen-status
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
