[Unit]
Description=Avaota A1 small-screen status page
# Draws /dev/fb1 directly and never switches virtual terminals, so it has no ordering against the display manager.
After=systemd-modules-load.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/avaota-small-screen-status
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
