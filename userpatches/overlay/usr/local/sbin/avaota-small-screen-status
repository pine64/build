#!/usr/bin/env python3
"""Avaota A1 small LCD (ST7789V, /dev/fb1): a text console on VT2, with a status page while the console is not shown.

- VT2 is mapped to the LCD. Ctrl+Alt+F2 shows a login console there (and keyboard input goes to it); Ctrl+Alt+F7
  returns to the HDMI desktop.
- While another VT is in front, the LCD shows a status page: host name, IP addresses, Home Assistant, Zigbee dongle,
  time. The page is drawn straight into the framebuffer.
- Without a connected HDMI monitor the console is brought to the front by itself, so the board stays usable with
  just the LCD and a keyboard. When HDMI comes back, the desktop VT is brought back. Nothing switches while Xorg is
  starting: the first switch waits until the boot has finished.

Environment: FRAMEBUFFER_DEVICE (default /dev/fb1), CONSOLE_VT (2), DESKTOP_VT (7), INTERVAL seconds (10),
ONCE=1 to draw a single frame and exit.
"""
import os
import socket
import subprocess
import sys
import time
import urllib.request

from PIL import Image, ImageDraw, ImageFont

FB = os.environ.get("FRAMEBUFFER_DEVICE", "/dev/fb1")
INTERVAL = float(os.environ.get("INTERVAL", "10"))
CONSOLE_VT = int(os.environ.get("CONSOLE_VT", "2"))
DESKTOP_VT = int(os.environ.get("DESKTOP_VT", "7"))
HDMI_GLOB = "/sys/class/drm/card*-HDMI-A-*/status"
FONT_DIR = "/usr/share/fonts/truetype/dejavu"
GREEN, RED, GREY, WHITE = (80, 220, 120), (240, 90, 80), (150, 150, 150), (255, 255, 255)


def sysfs(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def fb_geometry(fb):
    name = os.path.basename(fb)
    w, h = (int(v) for v in sysfs(f"/sys/class/graphics/{name}/virtual_size", "240,135").split(","))
    bpp = int(sysfs(f"/sys/class/graphics/{name}/bits_per_pixel", "16"))
    return w, h, bpp


def unblank(fb):
    try:
        with open(f"/sys/class/graphics/{os.path.basename(fb)}/blank", "w") as f:
            f.write("0")
    except OSError:
        pass


def run(*cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return None


def active_vt():
    v = sysfs("/sys/class/tty/tty0/active")
    return int(v[3:]) if v.startswith("tty") and v[3:].isdigit() else 0


def hdmi_connected():
    import glob
    return any(sysfs(p) == "connected" for p in glob.glob(HDMI_GLOB))


def boot_finished():
    r = run("systemctl", "is-system-running")
    return r is not None and r.stdout.strip() in ("running", "degraded")


def map_console(fb):
    fb_index = os.path.basename(fb).replace("fb", "")
    run("con2fbmap", str(CONSOLE_VT), fb_index)


def ip_addresses():
    try:
        out = subprocess.run(["ip", "-4", "-o", "addr", "show", "scope", "global"],
                             capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return []
    result = []
    for line in out.splitlines():
        parts = line.split()
        if len(parts) >= 4 and not parts[1].startswith(("docker", "br-", "veth")):
            result.append((parts[1], parts[3].split("/")[0]))
    return result


def home_assistant_up():
    try:
        urllib.request.urlopen("http://127.0.0.1:8123/manifest.json", timeout=3)
        return True
    except Exception:
        return False


def zigbee_dongle():
    ports = sorted(p for p in os.listdir("/dev") if p.startswith(("ttyUSB", "ttyACM")))
    return ports[0] if ports else ""


def font(size, bold=False):
    name = "DejaVuSans-Bold.ttf" if bold else "DejaVuSans.ttf"
    try:
        return ImageFont.truetype(os.path.join(FONT_DIR, name), size)
    except OSError:
        return ImageFont.load_default()


def render(w, h):
    img = Image.new("RGB", (w, h), (0, 0, 0))
    d = ImageDraw.Draw(img)
    big, small = font(18, bold=True), font(14)
    y = 4
    d.text((6, y), socket.gethostname(), font=big, fill=WHITE)
    d.text((w - 6, y + 3), time.strftime("%H:%M"), font=small, fill=GREY, anchor="ra")
    y += 26
    addrs = ip_addresses()
    if not addrs:
        d.text((6, y), "No network", font=small, fill=RED)
        y += 20
    for dev, ip in addrs[:2]:
        d.text((6, y), ip, font=small, fill=WHITE)
        d.text((w - 6, y), dev, font=small, fill=GREY, anchor="ra")
        y += 20
    ha = home_assistant_up()
    d.text((6, y), "Home Assistant", font=small, fill=WHITE)
    d.text((w - 6, y), ":8123 up" if ha else "starting", font=small, fill=GREEN if ha else GREY, anchor="ra")
    y += 20
    port = zigbee_dongle()
    d.text((6, y), "Zigbee dongle", font=small, fill=WHITE)
    d.text((w - 6, y), port if port else "none", font=small, fill=GREEN if port else GREY, anchor="ra")
    d.text((w // 2, h - 4), f"Ctrl+Alt+F{CONSOLE_VT}: console", font=font(12), fill=GREY, anchor="ms")
    return img


def to_rgb565(img):
    out = bytearray(img.width * img.height * 2)
    i = 0
    for r, g, b in img.getdata():
        v = ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3)
        out[i] = v & 0xFF
        out[i + 1] = v >> 8
        i += 2
    return bytes(out)


def main():
    while not os.path.exists(FB):
        time.sleep(2)
    w, h, bpp = fb_geometry(FB)
    if bpp != 16:
        sys.exit(f"{FB}: {bpp} bits per pixel is not supported")
    unblank(FB)
    if os.environ.get("ONCE") == "1":
        with open(FB, "wb") as f:
            f.write(to_rgb565(render(w, h)))
        return
    map_console(FB)
    hdmi_was = None
    last_draw = 0.0
    while True:
        # Follow HDMI only once the boot is done, so no VT switch races Xorg starting up.
        if boot_finished():
            hdmi = hdmi_connected()
            if hdmi != hdmi_was:
                vt = active_vt()
                if not hdmi and vt != CONSOLE_VT:
                    run("chvt", str(CONSOLE_VT))
                elif hdmi and hdmi_was is False and vt == CONSOLE_VT:
                    run("chvt", str(DESKTOP_VT))
                hdmi_was = hdmi
        # fbcon draws the console while VT2 is in front; the status page only fills the LCD otherwise.
        if active_vt() != CONSOLE_VT and time.monotonic() - last_draw >= INTERVAL:
            with open(FB, "wb") as f:
                f.write(to_rgb565(render(w, h)))
            last_draw = time.monotonic()
        elif active_vt() == CONSOLE_VT:
            last_draw = 0.0  # redraw at once when the console is left
        time.sleep(1)


if __name__ == "__main__":
    main()
